# Database configuration
# Local default: SQLite. For production (e.g. Vercel, Render), provide a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./citizen_navigator.db

# Application secret
SECRET_KEY=change-this-in-production

# Gemini AI Assistant
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Dedicated Google Cloud Speech-to-Text key for server-side audio transcription.
# If omitted, browser native Web Speech API is used first, and GEMINI_API_KEY is used as fallback.
GOOGLE_SPEECH_API_KEY=

# DigiLocker settings (mock implementation included out of the box)
DIGILOCKER_CLIENT_ID=mock-client-id
DIGILOCKER_CLIENT_SECRET=mock-client-secret
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/digilocker/callback

ENV=development
